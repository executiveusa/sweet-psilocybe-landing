# Database
DATABASE_URL=postgres://localhost/medusa-store

# Redis
REDIS_URL=redis://localhost:6379

# Medusa
JWT_SECRET=something
COOKIE_SECRET=something

# CORS
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:7001

# Avatar Engine / CrewAI
CREW_GATEWAY_URL=http://localhost:8080
AVATAR_ENGINE_API_KEY=your_avatar_api_key_here

# Medusa Admin
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=

# OpenAI (for avatar intelligence)
OPENAI_API_KEY=your_openai_key_here
