# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Sweet Psilocybe"

# Store URL (Shopware Frontends - separate deployment)
NEXT_PUBLIC_STORE_URL=https://store.sweetpsilocybe.com

# Medusa Backend Configuration
# URL where the Medusa backend is running
MEDUSA_BACKEND_URL=http://localhost:9000

# Avatar Engine / CrewAI Configuration
# URL for the avatar/crew gateway service
CREW_GATEWAY_URL=http://localhost:8080
AVATAR_ENGINE_API_KEY=your_avatar_api_key_here
